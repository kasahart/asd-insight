{
  "name": "asd-insight",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/production/*.test.mjs",
    "lint": "oxlint src packages",
    "predev": "npm run runtime:check && node scripts/prepare-static.mjs",
    "prebuild": "npm run runtime:check && node scripts/prepare-static.mjs",
    "test:reference": "node tests/production/evaluation-reference.test.mjs",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "e2e:server": "npm run build && vite preview --host 127.0.0.1 --strictPort",
    "runtime:prepare": "python3 scripts/prepare-audio-runtime.py",
    "runtime:check": "python3 scripts/prepare-audio-runtime.py --check",
    "test:audio": "node scripts/verify-audio-runtime.mjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.1",
    "fake-indexeddb": "6.2.5",
    "oxfmt": "0.61.0",
    "oxlint": "1.76.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-test-renderer": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  },
  "type": "module"
}
